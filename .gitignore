# ============================================================
# CommunityManagement - Root .gitignore
# NestJS / Prisma / Next.js / TypeScript
# ============================================================

# Dependencies and package manager caches
node_modules/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz

# Environment variables and local secrets
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.p12
*.pfx

# Build output
**/dist/
**/build/
**/.next/
**/out/
**/.output/
**/.nuxt/
**/.vercel/
**/.turbo/
**/coverage/
*.tsbuildinfo
*.eslintcache

# Generated Prisma Client (configured in backend/prisma/schema.prisma)
**/src/generated/

# Runtime logs and temporary files
*.log
logs/
.tmp/
tmp/
temp/
.cache/
*.pid
*.pid.lock

# Local uploads / private storage
**/uploads/
**/storage/private/

# IDE and operating system files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~

# Local databases and backups (not database/schema.sql)
*.sqlite
*.sqlite-journal
*.sqlite3
*.db
*.sql.gz
*.dump

# Next.js generated type declaration
**/next-env.d.ts

# Local test artifacts
playwright-report/
test-results/
.nyc_output/