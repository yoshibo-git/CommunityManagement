{
  "dependencies": {
    "@nestjs/common": "^11.2.10",
    "@nestjs/core": "^11.2.10",
    "@nestjs/platform-express": "^11.2.10",
    "@prisma/adapter-mariadb": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.9",
    "mariadb": "^3.5.4",
    "pdf-parse": "2.4.5",
    "prisma": "^7.10.1",
    "read-excel-file": "9.3.20",
    "redis": "^6.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sanitize-html": "^2.18.2"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc --noEmit --incremental false",
    "prebuild": "npm run prisma:generate",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:status": "prisma migrate status",
    "prisma:studio": "prisma studio",
    "prisma:seed": "npm run build && prisma db seed",
    "prisma:seed:system": "npm run build && node dist/prisma/seed-system.js",
    "test:foundation": "npm run build && node --test test/foundation.test.cjs",
    "test:foundation:db": "npm run build && node --test test/foundation-db.test.cjs",
    "test:auth": "npm run build && node --test test/auth-system.test.cjs"
  },
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.8"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.13",
    "@types/node": "^26.6.6",
    "@types/sanitize-html": "^2.16.2",
    "eslint": "^10.15.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
