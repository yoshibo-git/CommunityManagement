# Single connection source for Prisma CLI, runtime and seed.
# Use a dedicated database user. Percent-encode special characters in credentials.
# Query parameters are not supported by the current runtime configuration.
DATABASE_URL="mysql://community_app:replace_me@127.0.0.1:3306/community_management"

PORT=3000
# Password-only login is temporarily supported in local development only.
NODE_ENV=development
# Exact browser origins, comma-separated; empty disables cross-origin access.
# Use a different port for the frontend when running locally.
CORS_ALLOWED_ORIGINS="http://localhost:3001"

AUTH_PASSWORD_ONLY=false
REDIS_URL="redis://default:replace_me@127.0.0.1:6379/0"
# Generate a random secret of at least 64 characters before enabling login.
SESSION_SECRET=""
# Set only while running prisma:seed:system; existing account passwords are preserved.
# SEED_ACCOUNT_PASSWORD="replace_me"
# FaceIO, Email and Storage are not required for this local password-login stage.
