generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

model bai_dang {
  id_bai_dang    Int        @id @default(autoincrement()) @db.UnsignedInt
  id_nguoi_dang  Int        @db.UnsignedInt
  tieu_de        String     @db.VarChar(255)
  thoi_gian_dang DateTime? @db.DateTime(0)
  noi_dung       String     @db.Text
  hinh_anh       String?    @db.VarChar(500)
  trang_thai     String     @default("draft") @db.VarChar(30)
  nguoi_dung     nguoi_dung @relation(fields: [id_nguoi_dang], references: [id_nguoi_dung], onDelete: Restrict, onUpdate: Cascade, map: "fk_bai_dang_nguoi_dang")

  @@index([id_nguoi_dang], map: "idx_bai_dang_nguoi_dang")
}

model chi_tiet_hoat_dong {
  id_chi_tiet_hoat_dong Int                  @id @default(autoincrement()) @db.UnsignedInt
  id_hoat_dong          Int                  @unique(map: "uq_chi_tiet_hoat_dong") @db.UnsignedInt
  thoi_gian_bat_dau     DateTime             @db.DateTime(0)
  thoi_gian_ket_thuc    DateTime             @db.DateTime(0)
  dia_diem              String?              @db.Text
  vi_do                 Decimal?             @db.Decimal(10, 7)
  kinh_do               Decimal?             @db.Decimal(10, 7)
  yeu_cau_check_out     Boolean              @default(false)
  hoat_dong             hoat_dong            @relation(fields: [id_hoat_dong], references: [id_hoat_dong], onDelete: Cascade, onUpdate: Cascade, map: "fk_chi_tiet_hoat_dong_hoat_dong")
  phan_cong_nhiem_vu    phan_cong_nhiem_vu[]
  phien_diem_danh       phien_diem_danh[]

}

model dang_ky_hoat_dong {
  id_dang_ky        Int                 @id @default(autoincrement()) @db.UnsignedInt
  id_nguoi_dung     Int                 @db.UnsignedInt
  id_hoat_dong      Int                 @db.UnsignedInt
  thoi_gian_dang_ky DateTime            @default(now()) @db.DateTime(0)
  trang_thai        String              @default("registered") @db.VarChar(30)
  hoat_dong         hoat_dong           @relation(fields: [id_hoat_dong], references: [id_hoat_dong], onDelete: Cascade, onUpdate: Cascade, map: "fk_dang_ky_hoat_dong")
  nguoi_dung        nguoi_dung          @relation(fields: [id_nguoi_dung], references: [id_nguoi_dung], onDelete: Restrict, onUpdate: Cascade, map: "fk_dang_ky_nguoi_dung")
  ket_qua_diem_danh ket_qua_diem_danh[]

  @@unique([id_nguoi_dung, id_hoat_dong], map: "uq_dang_ky_nguoi_dung_hoat_dong")
  @@index([id_hoat_dong], map: "idx_dang_ky_hoat_dong")
}

model de_xuat_hoat_dong {
  id_de_xuat        Int              @id @default(autoincrement()) @db.UnsignedInt
  id_don_vi         Int              @db.UnsignedInt
  ben_lien_he       String?          @db.VarChar(150)
  email_lien_he     String?          @db.VarChar(150)
  so_dien_thoai     String?          @db.VarChar(20)
  ten_hoat_dong     String           @db.VarChar(255)
  mo_ta             String?          @db.Text
  dia_diem          String?          @db.Text
  thoi_gian_du_kien DateTime?        @db.DateTime(0)
  trang_thai        String           @default("pending") @db.VarChar(30)
  id_nguoi_duyet    Int?             @db.UnsignedInt
  ly_do_tu_choi     String?          @db.Text
  don_vi_ben_ngoai  don_vi_ben_ngoai @relation(fields: [id_don_vi], references: [id_don_vi], onDelete: Restrict, onUpdate: Cascade, map: "fk_de_xuat_don_vi")
  nguoi_dung        nguoi_dung?      @relation(fields: [id_nguoi_duyet], references: [id_nguoi_dung], onDelete: SetNull, onUpdate: Cascade, map: "fk_de_xuat_nguoi_duyet")
  hoat_dong         hoat_dong?

  @@index([id_don_vi], map: "idx_de_xuat_don_vi")
  @@index([id_nguoi_duyet], map: "idx_de_xuat_nguoi_duyet")
}

model diem_minh_chung {
  id_diem_minh_chung   Int                  @id @default(autoincrement()) @db.UnsignedInt
  id_minh_chung        Int                  @unique(map: "uq_diem_minh_chung") @db.UnsignedInt
  so_diem              Int
  ngay_cong_diem       DateTime             @default(now()) @db.DateTime(0)
  minh_chung_hoat_dong minh_chung_hoat_dong @relation(fields: [id_minh_chung], references: [id_minh_chung], onDelete: Cascade, onUpdate: Cascade, map: "fk_diem_minh_chung_minh_chung")
}

model don_vi_ben_ngoai {
  id_don_vi         Int                 @id @default(autoincrement()) @db.UnsignedInt
  ten_don_vi        String              @db.VarChar(200)
  loai_don_vi       String?             @db.VarChar(100)
  de_xuat_hoat_dong de_xuat_hoat_dong[]
  hoat_dong         hoat_dong[]
}

model hoat_dong {
  id_hoat_dong       Int                 @id @default(autoincrement()) @db.UnsignedInt
  id_don_vi          Int?                @db.UnsignedInt
  id_de_xuat         Int?                @unique(map: "uq_hoat_dong_de_xuat") @db.UnsignedInt
  id_nguoi_tao       Int                 @db.UnsignedInt
  ten_hoat_dong      String              @db.VarChar(255)
  mo_ta              String?             @db.Text
  gioi_han_dang_ky   Int?                @db.UnsignedInt
  diem_hoat_dong     Int                 @default(0)
  trang_thai         String              @default("draft") @db.VarChar(30)
  ke_hoach_hoat_dong String?             @db.VarChar(500)
  chi_tiet_hoat_dong chi_tiet_hoat_dong?
  dang_ky_hoat_dong  dang_ky_hoat_dong[]
  de_xuat_hoat_dong  de_xuat_hoat_dong?  @relation(fields: [id_de_xuat], references: [id_de_xuat], onDelete: SetNull, onUpdate: Cascade, map: "fk_hoat_dong_de_xuat")
  don_vi_ben_ngoai   don_vi_ben_ngoai?   @relation(fields: [id_don_vi], references: [id_don_vi], onDelete: SetNull, onUpdate: Cascade, map: "fk_hoat_dong_don_vi")
  nguoi_dung         nguoi_dung          @relation(fields: [id_nguoi_tao], references: [id_nguoi_dung], onDelete: Restrict, onUpdate: Cascade, map: "fk_hoat_dong_nguoi_tao")
  thong_bao          thong_bao[]

  @@index([id_don_vi], map: "idx_hoat_dong_don_vi")
  @@index([id_nguoi_tao], map: "idx_hoat_dong_nguoi_tao")
}

model ket_qua_diem_danh {
  id_ket_qua          Int               @id @default(autoincrement()) @db.UnsignedInt
  id_phien_diem_danh  Int               @db.UnsignedInt
  id_dang_ky          Int               @db.UnsignedInt
  thoi_gian_diem_danh DateTime          @default(now()) @db.DateTime(0)
  vi_do               Decimal?          @db.Decimal(10, 7)
  kinh_do             Decimal?          @db.Decimal(10, 7)
  dang_ky_hoat_dong   dang_ky_hoat_dong @relation(fields: [id_dang_ky], references: [id_dang_ky], onDelete: Restrict, onUpdate: Cascade, map: "fk_ket_qua_dang_ky")
  phien_diem_danh     phien_diem_danh   @relation(fields: [id_phien_diem_danh], references: [id_phien_diem_danh], onDelete: Cascade, onUpdate: Cascade, map: "fk_ket_qua_phien_diem_danh")

  @@unique([id_phien_diem_danh, id_dang_ky], map: "uq_ket_qua_phien_dang_ky")
  @@index([id_dang_ky], map: "idx_ket_qua_dang_ky")
}

model khoa {
  id_khoa    String       @id @db.VarChar(20)
  ten_khoa   String       @db.VarChar(150)
  nguoi_dung nguoi_dung[]
}

model minh_chung_hoat_dong {
  id_minh_chung                                              Int              @id @default(autoincrement()) @db.UnsignedInt
  id_nguoi_nop                                               Int              @db.UnsignedInt
  ten_hoat_dong                                              String           @db.VarChar(255)
  mo_ta                                                      String?          @db.Text
  don_vi_to_chuc                                             String?          @db.VarChar(200)
  ngay_tham_gia                                              DateTime?        @db.Date
  tep_minh_chung                                             String           @db.VarChar(500)
  ngay_nop                                                   DateTime         @default(now()) @db.DateTime(0)
  trang_thai                                                 String           @default("pending") @db.VarChar(30)
  id_nguoi_duyet                                             Int?             @db.UnsignedInt
  ly_do_tu_choi                                              String?          @db.Text
  diem_minh_chung                                            diem_minh_chung?
  nguoi_dung_minh_chung_hoat_dong_id_nguoi_duyetTonguoi_dung nguoi_dung?      @relation("minh_chung_hoat_dong_id_nguoi_duyetTonguoi_dung", fields: [id_nguoi_duyet], references: [id_nguoi_dung], onDelete: SetNull, onUpdate: Cascade, map: "fk_minh_chung_nguoi_duyet")
  nguoi_dung_minh_chung_hoat_dong_id_nguoi_nopTonguoi_dung   nguoi_dung       @relation("minh_chung_hoat_dong_id_nguoi_nopTonguoi_dung", fields: [id_nguoi_nop], references: [id_nguoi_dung], onDelete: Restrict, onUpdate: Cascade, map: "fk_minh_chung_nguoi_nop")

  @@index([id_nguoi_duyet], map: "idx_minh_chung_nguoi_duyet")
  @@index([id_nguoi_nop], map: "idx_minh_chung_nguoi_nop")
}

model nguoi_dung {
  id_nguoi_dung                                                        Int                    @id @default(autoincrement()) @db.UnsignedInt
  id_vai_tro                                                           Int                    @db.UnsignedInt
  id_khoa                                                              String?                @db.VarChar(20)
  loai_nguoi_dung                                                      String?                @db.VarChar(30)
  ten_dang_nhap                                                        String                 @unique(map: "uq_nguoi_dung_ten_dang_nhap") @db.VarChar(100)
  mat_khau                                                             String                 @db.VarChar(255)
  ho_ten                                                               String                 @db.VarChar(150)
  email                                                                String                 @unique(map: "uq_nguoi_dung_email") @db.VarChar(150)
  so_dien_thoai                                                        String?                @db.VarChar(20)
  trang_thai                                                           String                 @default("active") @db.VarChar(30)
  bai_dang                                                             bai_dang[]
  dang_ky_hoat_dong                                                    dang_ky_hoat_dong[]
  de_xuat_hoat_dong                                                    de_xuat_hoat_dong[]
  hoat_dong                                                            hoat_dong[]
  minh_chung_hoat_dong_minh_chung_hoat_dong_id_nguoi_duyetTonguoi_dung minh_chung_hoat_dong[] @relation("minh_chung_hoat_dong_id_nguoi_duyetTonguoi_dung")
  minh_chung_hoat_dong_minh_chung_hoat_dong_id_nguoi_nopTonguoi_dung   minh_chung_hoat_dong[] @relation("minh_chung_hoat_dong_id_nguoi_nopTonguoi_dung")
  khoa                                                                 khoa?                  @relation(fields: [id_khoa], references: [id_khoa], onDelete: SetNull, onUpdate: Cascade, map: "fk_nguoi_dung_khoa")
  vai_tro                                                              vai_tro                @relation(fields: [id_vai_tro], references: [id_vai_tro], onDelete: Restrict, onUpdate: Cascade, map: "fk_nguoi_dung_vai_tro")
  nguoi_nhan_thong_bao                                                 nguoi_nhan_thong_bao[]
  phan_cong_nhiem_vu                                                   phan_cong_nhiem_vu[]
  thong_tin_sinh_trac                                                  thong_tin_sinh_trac?

  @@index([id_khoa], map: "idx_nguoi_dung_khoa")
  @@index([id_vai_tro], map: "idx_nguoi_dung_vai_tro")
}

model nguoi_nhan_thong_bao {
  id_thong_bao  Int        @db.UnsignedInt
  id_nguoi_dung Int        @db.UnsignedInt
  da_doc        Boolean    @default(false)
  thoi_gian_doc DateTime?  @db.DateTime(0)
  nguoi_dung    nguoi_dung @relation(fields: [id_nguoi_dung], references: [id_nguoi_dung], onDelete: Cascade, onUpdate: Cascade, map: "fk_nguoi_nhan_thong_bao_nguoi_dung")
  thong_bao     thong_bao  @relation(fields: [id_thong_bao], references: [id_thong_bao], onDelete: Cascade, onUpdate: Cascade, map: "fk_nguoi_nhan_thong_bao_thong_bao")

  @@id([id_thong_bao, id_nguoi_dung])
  @@index([id_nguoi_dung], map: "idx_nguoi_nhan_thong_bao_nguoi_dung")
}

model phan_cong_nhiem_vu {
  id_phan_cong          Int                @id @default(autoincrement()) @db.UnsignedInt
  id_chi_tiet_hoat_dong Int                @db.UnsignedInt
  id_nguoi_dung         Int                @db.UnsignedInt
  ten_nhiem_vu          String             @db.VarChar(255)
  mo_ta_nhiem_vu        String?            @db.Text
  loai_nhiem_vu         String?            @db.VarChar(100)
  thoi_gian_bat_dau     DateTime?          @db.DateTime(0)
  thoi_gian_ket_thuc    DateTime?          @db.DateTime(0)
  trang_thai            String             @default("assigned") @db.VarChar(30)
  chi_tiet_hoat_dong    chi_tiet_hoat_dong @relation(fields: [id_chi_tiet_hoat_dong], references: [id_chi_tiet_hoat_dong], onDelete: Cascade, onUpdate: Cascade, map: "fk_phan_cong_chi_tiet")
  nguoi_dung            nguoi_dung         @relation(fields: [id_nguoi_dung], references: [id_nguoi_dung], onDelete: Restrict, onUpdate: Cascade, map: "fk_phan_cong_nguoi_dung")

  @@index([id_chi_tiet_hoat_dong], map: "idx_phan_cong_chi_tiet")
  @@index([id_nguoi_dung], map: "idx_phan_cong_nguoi_dung")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model phien_diem_danh {
  id_phien_diem_danh    Int                 @id @default(autoincrement()) @db.UnsignedInt
  id_chi_tiet_hoat_dong Int                 @db.UnsignedInt
  loai_diem_danh        String              @db.VarChar(30)
  thoi_gian_bat_dau     DateTime            @db.DateTime(0)
  thoi_gian_ket_thuc    DateTime            @db.DateTime(0)
  yeu_cau_gps           Boolean             @default(false)
  vi_do                 Decimal?            @db.Decimal(10, 7)
  kinh_do               Decimal?            @db.Decimal(10, 7)
  /// Don vi: met. Preserve the database column COMMENT in migration SQL.
  ban_kinh_cho_phep     Int?                @db.UnsignedInt
  trang_thai            String              @default("scheduled") @db.VarChar(30)
  ket_qua_diem_danh     ket_qua_diem_danh[]
  chi_tiet_hoat_dong    chi_tiet_hoat_dong  @relation(fields: [id_chi_tiet_hoat_dong], references: [id_chi_tiet_hoat_dong], onDelete: Cascade, onUpdate: Cascade, map: "fk_phien_diem_danh_chi_tiet")

  @@index([id_chi_tiet_hoat_dong], map: "idx_phien_diem_danh_chi_tiet")
}

model thong_bao {
  id_thong_bao         Int                    @id @default(autoincrement()) @db.UnsignedInt
  id_hoat_dong         Int?                   @db.UnsignedInt
  loai_thong_bao       String                 @db.VarChar(50)
  tieu_de              String                 @db.VarChar(255)
  noi_dung             String                 @db.Text
  thoi_gian_tao        DateTime               @default(now()) @db.DateTime(0)
  nguoi_nhan_thong_bao nguoi_nhan_thong_bao[]
  hoat_dong            hoat_dong?             @relation(fields: [id_hoat_dong], references: [id_hoat_dong], onDelete: SetNull, onUpdate: Cascade, map: "fk_thong_bao_hoat_dong")

  @@index([id_hoat_dong], map: "idx_thong_bao_hoat_dong")
}

model thong_tin_sinh_trac {
  id_sinh_trac  Int        @id @default(autoincrement()) @db.UnsignedInt
  id_nguoi_dung Int        @unique(map: "uq_sinh_trac_nguoi_dung") @db.UnsignedInt
  id_khuon_mat  String     @unique(map: "uq_sinh_trac_khuon_mat") @db.VarChar(255)
  mau_khuon_mat Json?
  ngay_dang_ky  DateTime?  @db.DateTime(0)
  /// Database-managed ON UPDATE CURRENT_TIMESTAMP is preserved in migration SQL.
  /// Prisma cannot model this clause; preserve it when altering this column.
  ngay_cap_nhat DateTime   @default(now()) @db.DateTime(0)
  nguoi_dung    nguoi_dung @relation(fields: [id_nguoi_dung], references: [id_nguoi_dung], onDelete: Cascade, onUpdate: Cascade, map: "fk_sinh_trac_nguoi_dung")
}

model vai_tro {
  id_vai_tro  Int          @id @default(autoincrement()) @db.UnsignedInt
  ten_vai_tro String       @unique(map: "uq_vai_tro_ten") @db.VarChar(100)
  mo_ta       String?      @db.Text
  nguoi_dung  nguoi_dung[]
}
