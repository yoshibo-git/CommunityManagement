# Server-only endpoint used by the API proxy and authenticated pages.
BACKEND_URL="http://127.0.0.1:3000"

# Leaflet uses OpenStreetMap tiles by default; no API key is needed.
# Optional alternative HTTPS tile provider; replace attribution as required by that provider.
# NEXT_PUBLIC_MAP_TILE_URL="https://tile.openstreetmap.org/{z}/{x}/{y}.png"
# NEXT_PUBLIC_MAP_TILE_ATTRIBUTION='&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
# Optional Photon-compatible geocoder. Public demo is suitable only for reasonable, moderate usage.
# NEXT_PUBLIC_GEOCODER_URL="https://photon.komoot.io/api/"
